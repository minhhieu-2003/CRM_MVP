{
  "name": "crm_mvp",
  "version": "1.0.0",
  "description": "CRM AI Agent MVP for Vietnamese Relationship Manager workflow",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "mcp": "node --env-file-if-exists=.env src/mcp/server.js",
    "test": "node --test tests/**/*.test.mjs",
    "test:http": "node --test tests/integration/http-api.test.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm test && npm run test:crm",
    "smoke:local": "node scripts/qa/smoke-local.mjs",
    "db:init": "python scripts/db/init_db.py",
    "db:verify": "python scripts/db/verify_db.py",
    "test:crm": "node scripts/qa/run-crm-test-cases.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "express": "^4.19.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4"
  }
}
