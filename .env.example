# Cấu hình CRM API của Bank A.
# Chế độ chạy: mock, sandbox, hoặc production.
CRM_MODE=mock
CRM_API_BASE_URL=https://sandbox.crm.BankA.vn
CRM_API_KEY=
CRM_API_AUTH_SCHEME=api-key
CRM_API_KEY_HEADER=X-API-Key
CRM_TIMEOUT_MS=5000

# Cấu hình plugin LLM fallback (tùy chọn).
# Khi rule engine IF/ELSE không khớp intent, agent sẽ gọi LLM qua endpoint đã phê duyệt.
# Nếu KHÔNG đặt đúng các biến này, hệ thống tự dùng fallback tĩnh (không gọi API bên ngoài).

# Provider hỗ trợ:
# - openai-compatible: proxy Chat Completions tương thích OpenAI.
# - gemini: Gemini API key flow qua generativelanguage.googleapis.com.
# - vertex-openai: Vertex AI OpenAI-compatible endpoint, dùng project/location + OAuth access token.
LLM_PROVIDER=openai-compatible

# openai-compatible: endpoint Chat Completions bắt buộc.
# gemini: có thể để trống để dùng endpoint mặc định của Gemini API, hoặc điền endpoint generateContent custom.
# vertex-openai: có thể để trống để tự dựng endpoint từ LLM_GOOGLE_PROJECT + LLM_VERTEX_LOCATION.
LLM_API_URL=https://your-approved-proxy.example.com/v1/chat/completions

# openai-compatible/gemini: API key.
# vertex-openai: OAuth access token hoặc token do proxy nội bộ cấp.
LLM_API_KEY=

# Model sử dụng.
# openai-compatible mặc định gpt-4o-mini, gemini mặc định gemini-2.0-flash,
# vertex-openai mặc định google/gemini-2.0-flash-001 nếu không đặt biến này.
LLM_MODEL=gpt-4o-mini

# Chỉ dùng cho vertex-openai. Có thể điền dạng "1057788120606" hoặc "projects/1057788120606".
LLM_GOOGLE_PROJECT=
LLM_VERTEX_LOCATION=us-central1

# Giới hạn số bản ghi CRM đưa vào prompt LLM để tránh prompt quá lớn.
LLM_CONTEXT_CUSTOMER_LIMIT=20
LLM_CONTEXT_OPPORTUNITY_LIMIT=20
LLM_CONTEXT_CAMPAIGN_LIMIT=10
