# Runtime
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Demo authentication. Pilot/production require AUTH_ENABLED=true and a secret token.
AUTH_ENABLED=false
AUTH_DEMO_TOKEN=
AUTH_DEMO_USER_ID=demo-rm
AUTH_DEMO_RM_ID=RM01
AUTH_DEMO_BRANCH_ID=HN
AUTH_DEMO_ENTITLEMENTS=customer:read,opportunity:read,interaction:read,campaign:read,communication:draft
AUTH_ADMIN_TOKEN=
AUTH_ADMIN_USER_ID=admin
# Admin wildcard access is granted only when this is explicitly set to *.
AUTH_ADMIN_ENTITLEMENTS=
# Authentication-disabled local demo only; these are capabilities, not an authenticated trust claim.
AUTH_LOCAL_DEMO_ENTITLEMENTS=customer:read,opportunity:read,interaction:read,campaign:read,communication:draft

# CRM provider: mock, sqlite, postgres, or sandbox.
# Pilot/production reject mock mode.
CRM_MODE=mock
CRM_SQLITE_PATH=db/crm.db
CRM_POSTGRES_URL=
CRM_API_BASE_URL=https://sandbox.crm.BankA.vn
CRM_API_KEY=
CRM_API_AUTH_SCHEME=api-key
CRM_API_KEY_HEADER=X-API-Key
CRM_TIMEOUT_MS=5000

# AI-native core: configured proxy planner -> tool execution -> grounded synthesis.
# Keep disabled when a configured proxy is unavailable; the rule engine remains active.
AI_NATIVE_CORE=false
AI_AGENT_MAX_STEPS=6
AI_DATA_CLASSIFICATION=synthetic

# MCP-native execution uses one isolated stdio session per AI chat turn.
MCP_CONNECT_TIMEOUT_MS=3000
MCP_REQUEST_TIMEOUT_MS=7000
MCP_TURN_TIMEOUT_MS=15000
MCP_RETRY_LIMIT=1
MCP_MAX_CONCURRENT_SESSIONS=8
MCP_ALLOW_STDIO_ON_SERVERLESS=false
MCP_OBSERVATION_MAX_AGE_MS=60000

LLM_API_URL=https://your-configured-proxy.example.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=bankrm-configured-model
LLM_TIMEOUT_MS=12000

# Bound the legacy deterministic fallback context sent through the same configured proxy.
LLM_CONTEXT_CUSTOMER_LIMIT=20
LLM_CONTEXT_OPPORTUNITY_LIMIT=20
LLM_CONTEXT_CAMPAIGN_LIMIT=10

# Bounded in-memory conversation context.
CONTEXT_TTL_MS=1800000
CONTEXT_MAX_CONVERSATIONS=1000
CONTEXT_MAX_FOCUSED_CUSTOMERS=50

# Audit controls.
AUDIT_LOG_DIR=
# Required when AUTH_ENABLED=true and in pilot/production. Use a dedicated high-entropy
# value (at least 32 UTF-8 bytes); never reuse HTTP, CRM, auth, or LLM credentials.
AUDIT_CORRELATION_KEY=
AUDIT_MAX_PROMPT_LENGTH=1000
AUDIT_MAX_MEMORY_LOGS=200
AUDIT_MAX_READ_BYTES=2097152
