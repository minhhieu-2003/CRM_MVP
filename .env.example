# Cấu hình plugin LLM fallback (tùy chọn).
# Khi rule engine IF/ELSE không khớp intent, agent sẽ gọi LLM qua proxy có logging.
# Nếu KHÔNG đặt các biến này, hệ thống tự dùng fallback tĩnh (không gọi API bên ngoài).

# Endpoint proxy LLM tương thích OpenAI Chat Completions (bắt buộc để bật fallback).
LLM_API_URL=https://your-approved-proxy.example.com/v1/chat/completions

# API key gọi qua proxy đã được phê duyệt (bắt buộc để bật fallback).
LLM_API_KEY=

# Model sử dụng (mặc định gpt-4o-mini).
LLM_MODEL=gpt-4o-mini
