# Runtime
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Demo authentication. Pilot/production require AUTH_ENABLED=true and a secret token.
AUTH_ENABLED=false
AUTH_DEMO_TOKEN=
AUTH_ADMIN_TOKEN=

# CRM provider: mock, sqlite, postgres, or sandbox.
# Pilot/production reject mock mode.
CRM_MODE=mock
CRM_SQLITE_PATH=db/crm.db
CRM_POSTGRES_URL=
CRM_API_BASE_URL=https://sandbox.crm.BankA.vn
CRM_API_KEY=
CRM_API_AUTH_SCHEME=api-key
CRM_API_KEY_HEADER=X-API-Key
CRM_TIMEOUT_MS=5000

# AI-native core: approved proxy planner -> tool execution -> grounded synthesis.
# Keep disabled when an approved proxy is unavailable; the rule engine remains active.
AI_NATIVE_CORE=false
AI_AGENT_MAX_STEPS=6
AI_DATA_CLASSIFICATION=synthetic
LLM_API_URL=https://your-approved-proxy.example.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=bankrm-approved-model
LLM_TIMEOUT_MS=12000

# Bound the legacy deterministic fallback context sent through the same approved proxy.
LLM_CONTEXT_CUSTOMER_LIMIT=20
LLM_CONTEXT_OPPORTUNITY_LIMIT=20
LLM_CONTEXT_CAMPAIGN_LIMIT=10

# Bounded in-memory conversation context.
CONTEXT_TTL_MS=1800000
CONTEXT_MAX_CONVERSATIONS=1000
CONTEXT_MAX_FOCUSED_CUSTOMERS=50

# Audit controls.
AUDIT_LOG_DIR=
AUDIT_MAX_PROMPT_LENGTH=1000
AUDIT_MAX_MEMORY_LOGS=200
